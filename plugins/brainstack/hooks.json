{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./runtime/vgb hook session-start",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "./runtime/vgb hook session-catchup",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./runtime/vgb hook session-end",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./runtime/vgb hook pre-compact",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
