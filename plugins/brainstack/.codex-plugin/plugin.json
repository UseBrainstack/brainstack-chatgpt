{
  "name": "brainstack",
  "version": "0.1.0",
  "description": "Brainstack for the ChatGPT desktop app (Codex + ChatGPT-work) — one native binary does the connector AND automatic capture hooks. No Node. Secret-less OAuth.",
  "author": {
    "name": "Brainstack",
    "email": "hello@usebrainstack.com"
  },
  "homepage": "https://usebrainstack.com",
  "license": "UNLICENSED",
  "keywords": [
    "knowledge-management",
    "rbac",
    "mcp",
    "oauth",
    "zero-install",
    "cross-platform",
    "codex",
    "chatgpt"
  ],
  "mcpServers": "./.mcp.json",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            { "type": "command", "command": "./runtime/vgb hook session-start", "timeout": 10 },
            { "type": "command", "command": "./runtime/vgb hook session-catchup", "timeout": 30 }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            { "type": "command", "command": "./runtime/vgb hook session-end", "timeout": 30 }
          ]
        }
      ]
    }
  },
  "interface": {
    "displayName": "Brainstack",
    "shortDescription": "Your company memory — capture + connector",
    "longDescription": "Brainstack captures your local Codex / ChatGPT-work sessions automatically and gives you the Brainstack connector to query your brain, all from one native binary (no Node required). Sign in once; secret-less OAuth.",
    "developerName": "Brainstack",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://usebrainstack.com",
    "defaultPrompt": [
      "Search my brain for what we decided about ..."
    ]
  }
}
